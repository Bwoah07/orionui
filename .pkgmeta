# BigWigs packager config. One tag builds one zip containing the release addons.
# OrionUI_Dev is never shipped (CLAUDE.md §17).
package-as: OrionUI

enable-nolib-creation: no

move-folders:
  OrionUI/OrionUI: OrionUI
  # OrionUI/OrionUI_Installer: OrionUI_Installer   # enable in phase 5

# Libraries are fetched at package time, never committed. URLs match what DBM/BigWigs use.
# For local dev run tools/fetch-libs.sh.
externals:
  OrionUI/Libs/LibStub: https://repos.wowace.com/wow/libstub/trunk
  OrionUI/Libs/LibSerialize: https://github.com/rossnichols/LibSerialize.git
  OrionUI/Libs/LibDeflate: https://github.com/SafeteeWoW/LibDeflate.git

ignore:
  - OrionUI_Dev
  - OrionUI_Installer
  - docs
  - tests
  - CLAUDE.md
  - .luacheckrc
  - .editorconfig
  - .busted
  - tools
