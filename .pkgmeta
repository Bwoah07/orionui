# BigWigs packager config (CurseForge / Wago). The repository root is the addon folder;
# a version tag builds RaidControl-<tag>.zip.
package-as: RaidControl

enable-nolib-creation: no

# Libraries are fetched at package time, never committed. For local dev run tools/fetch-libs.sh.
externals:
  Libs/Ace3: https://repos.curseforge.com/wow/ace3/trunk
  Libs/LibSharedMedia-3.0: https://repos.curseforge.com/wow/libsharedmedia-3-0/trunk

ignore:
  - tools
  - dist
  - CLAUDE.md
  - .editorconfig
  - .gitattributes
